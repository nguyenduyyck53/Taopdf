{
  "name": "vietocr-studio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config static/vite.config.ts",
    "preview:pages": "vite preview --config static/vite.config.ts",
    "start": "vinext start",
    "test": "vinext build && vite build --config static/vite.config.ts && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "docx": "9.5.1",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
